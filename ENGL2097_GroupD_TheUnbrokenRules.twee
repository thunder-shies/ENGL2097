:: Sidebar [sidebar] {"position":"400,50","size":"100,100"}
{
<!-- PERSISTENT SIDEBAR - Always visible on right side
     Displays: Player status, sanity meter, inventory
     Sanity changes color based on danger level
     Updates in real-time as story progresses -->(append: ?Sidebar)[
$statusText[STATUS]
<br>
$sanityText[SANITY]
(if: $sanity <= 30)[<script>$('span').addClass('danger');</script>]\
(else:)[<script>$('span').addClass('healthy');</script>]
<span id="sanity-val">$sanityNumText[$sanity%]</span>

<div class="sanity-bar-bg">
  <div class="sanity-bar-fill" id="sanity-fill"></div>
</div>
<script>
  setTimeout(function() {
    var textEl = document.getElementById('sanity-val');
    if (textEl) {
      var val = parseInt(textEl.innerText);
      window.updateSanityBar(val);
    }
  }, 100);
</script>

<hr>
$invText[INVENTORY]
(if: $hasRulesBrochure or $hasUpdatedRules or $hasDrifterWarning)[
  (if: $hasRulesBrochure)[
    (link: "Rules Brochure")[
      (set: $popupImg to "https://i.imgur.com/xjMiha8.png")
      (show: ?PopupWindow)
    ]
    <br>
  ]
  (if: $hasUpdatedRules)[
    (link: "Updated Rules")[
      (set: $popupImg to "https://i.imgur.com/EmxxNKx.png")
      (show: ?PopupWindow)
    ]
    <br>
  ]
  (if: $hasDrifterWarning)[
    (link: "Drifter's Warning")[
      (set: $popupImg to "https://i.imgur.com/evSo7Sf.png")
      (show: ?PopupWindow)
    ]
  ]
]
(else:)[
  $itemText[Empty]
]
<br>
$footerText[Maintain your composure.]
]
}


:: Stand your ground, too terrified to move [en end] {"position":"1725,400","size":"100,100"}
{(set: $sanity to 0)
(set: $dialogs to (a: 
  "I stood rooted to the spot, not daring to flinch. The rule was clear: |imp>[Do not leave without instruction.] (I clung to that sentence like a lifeline, quickly shoving my phone into my pocket. My entire body shook as I stared into the contorted, hideous face of the creature before me.)",
  "The staff member tilted its head, its voice a sickening, dry rasp.",
  "|imp>[So obedient,]",
  "it hissed. ",
  "|imp>[And yet... you are still too late.]",
  "(Before I could even gasp, its jagged, inhuman claw lunged forward. It didn't just stab me; it skewered my chest. A dull, cold shock radiated from the wound, followed by a searing heat that consumed my lungs.)",
  "I looked down, watching my own blood drench the very rules I had tried so hard to follow. (Darkness began to cloud my vision, and as my heart gave its final, frantic thud, I realized the cruelest truth of this park:)",
  "(text-style:'shudder')|imp>[In here, the rules weren't meant to save you. They were only meant to keep you still long enough for the slaughter.]",
  "|shake>[Cause of death: Obedience exploited — slaughter by staff.]",
))
(set: $names to (a: "", "", "Staff", "", "Staff", "", "", "", "THE END"))
(set: $step to 1)
(set: $msgName to $names's 1)
(set: $nextPassage to "none")
(set: $audioTriggerStep to 8)
(set: $audioUrl to "https://cdn.freesound.org/previews/584/584318_12865053-lq.mp3")

(display: "DialogBox")
(display: "Styles")

<audio src="https://cdn.freesound.org/previews/713/713696_10403690-lq.mp3
" autoplay>
}

|choices)[
(button:)[(link: "Restart")[(restart:)]]
]


