:: Startup [startup] {"position":"100,50","size":"100,100"}
{
<!-- ============================================
     INITIALIZATION PASSAGE
     Sets up all game variables, tracking flags,
     and styling that persist throughout gameplay
     ============================================ -->

<!-- PLAYER STATUS & STATS -->
(set: $sanity to 100)
(set: $currentStatus to "Calm")
(set: $inventory to (a:))
(set: $hasRulesBrochure to false)
(set: $hasUpdatedRules to false)
(set: $hasDrifterWarning to false)

<!-- STORY BRANCH FLAGS - Track major decisions that affect gameplay outcomes -->
(set: $drifterHint to false)              <!-- Did player listen to the drifter? -->
(set: $friendMurder to false)             <!-- Did player push away the drifter? -->
(set: $isAskingAboutFriend to false)      <!-- Did player ask staff about escape? -->
(set: $isHonestAboutDrifter to false)     <!-- Did player tell Samuel the truth about drifter? -->
(set: $isHonestAboutStaff to false)       <!-- Player's trust level with staff -->
(set: $trustsAstor to false)              <!-- Does player trust Astor? -->
(set: $hasSeenColorRule to false)         <!-- Has player discovered the color-based rule system? -->

<!-- UI STYLING - Text color, size, and effects for displaying information -->
(set: $statusText to (text-color:#909090)+(font:"Bebas Neue"))
(set: $sanityText to (text-style:"expand")+(text-style:"subscript"))
(set: $sanityNumText to (text-size:2))
(set: $invText to (text-style:"expand")+(text-style:"subscript"))
(set: $itemText to (text-color:#666))
(set: $footerText to (text-color:#444)+(text-size:0.5))
(set: $type to (char-style: via (t8n-delay: pos * 30) + (t8n: "instant")))
(set: $samStart to '<div class="msg-box"><div class="msg-name">Samuel</div><div class="msg-content">')
(set: $msgEnd to '</div></div>')
(set: $textTriggerStep to 0)
(set: $popupTriggerStep to 0)
(set: $letterTriggerStep to 0)
(set: $audioTriggerStep to 0)
(set: $popupImg to "")
(set: $popupTarget to "")
}


:: Styles {"position":"100,175","size":"100,100"}
{
<!-- STYLING COMPONENT
     Applies visual effects to tagged text:
     - link: Red color, hover effects
     - highlight: Red emphasized text
     - imp: Important/ominous text (red, blinking, shudder)
     - shake: Red text with rumble effect -->
(enchant: ?link, (text-color:#d4183d)+(hover-style:(text-style:"tall","condense","shudder")))

(enchant:?highlight, (text-color:#d4183d)+(hover-style:(text-color:red)+(text-style:"tall","condense")+(text-size:1.2)))

(enchant:?imp, (text-color:#d4183d)+(text-style:"blurrier","blink")+(hover-style:(text-color:red)+(text-style:"smear","tall","fidget","expand")+(font: "Walktrought")))

(enchant: ?shake, (text-color:red)+(text-style:"bold","rumble"))
}


:: Survival [en] {"position":"3025,1000","size":"100,100"}
{
(set: $sanity to it - 8)
(set: $sanity to it - 15)
(set: $dialogs to (a: 
  "We scrambled into the cramped office, slamming the door just as Mabel’s heavy stabs at the wood began. In the dim light of a flickering monitor, I found a crumpled envelope on the desk. It was a letter from Mark, one of the lead designers.",
  "(As I read, a cold realization washed over me.)",
  "Samuel, Astor... look at this,",
  "The rules... they aren't meant to save us. Mark discovered the truth before he 'disappeared.' The monsters didn't just want us to suffer for breaking the rules; they wanted to condition us. Each rule is a psychological hook, designed to lead us step-by-step into a dead end where we can no longer fight back.",
  "(The 'Safe' Blue Uniforms, the 'Exit' signs, the 'Don't Look Back' command—it was all a setup to make our movements predictable. They profit from our blind obedience.)",
  "To escape,",
  "I said, looking at the door being battered from the outside,",
  "We have to stop thinking like victims. We have to find the flaws in their logic."
))

(set: $names to (a: "???", "", "Me", "Me", "", "Me", "", "Me"))
(set: $step to 1)
(set: $msgName to $names's ($step))
(set: $nextPassage to "none")

(display: "DialogBox")
(display: "Styles")
}

|choices)[
(button:)[[Find Mark's letter->Mark's letter in the office]]
]


