}


:: Unlock back door [en] {"position":"3575,750","size":"100,100"}
{
<!-- FINAL ESCAPE ATTEMPT
     Player runs through parking lot with three tunnel choices
     Sanity affects final ending (>60% vs <60%)
     Tests if player learned to break rules (choose bright light) -->
(set: $dialogs to (a: 
  "The path to the parking lot was more desolate than we imagined. The streetlamps flickered like dying pulses, stretching our shadows into grotesque shapes that seemed to chase us.",
  "The sickly sweet scent of the park had faded, replaced by the sharp tang of motor oil and a faint, metallic smell of fresh blood.",
  "Just as we neared the entrance, a piercing screech tore through the silence. From the gloom, dozens of twisted figures emerged—",
  "|highlight>[red-uniformed monsters and hollow-eyed puppets like Samuel, standing shoulder to shoulder to form an impenetrable wall of flesh and machinery.]",
  "(text-style:'shudder')[How did they know?]",
  "I gripped the five keys in my hand, remembering Mark’s warning about hallucinatory manipulation.",
  "|shake>[The entities knew our plan. They were using the rules to cage us.]",
  "It’s an illusion!",
  "Astor hissed, brandishing a broken table leg.",
  "The entities are controlling them. We have to break through!",
  "We charged. Astor fought like a man possessed, fending off the reaching claws while Clara and I sprinted into the depths of the parking lot.",
  "We reached a fork where three tunnels diverged, each bathed in a different light.",
  "Which one? If we choose wrong, we’re dead!",
  "Rule 6: 'Stay away from bright lights; they will bring you agony.'",
  "I looked at the steady beam in the third tunnel. Mark’s letter flashed in my mind: |shake>[The rules are the trap. The truth lies in the gaps.]",
  "The 'Rule' wants us to stay in the dark,",
  "I gritted my teeth, pointing to the third tunnel.",
  "That light... that's the only place the illusion can't reach. Follow me!",
  "The roars behind us grew deafening as the monsters broke through Astor’s defense, closing in step by step. Their silhouettes twisted and contorted in the dim light, sending a bone-chilling shiver down my spine.",
  "There’s no time to hesitate!"
))

(set: $names to (a: "", "", "", "", "Clara", "", "Me", "Astor", "", "Astor", "", "", "Clara", "Astor", "", "Me", "", "Me", "", "Me"))
(set: $step to 1)
(set: $msgName to $names's ($step))
(set: $nextPassage to "none")
(set: $textTriggerStep to 12)
(display: "DialogBox")
(display: "Styles")

|tunnelInfo)[
0. The First Tunnel: Littered with red uniforms, echoing with the hum of heavy machinery.
0. The Second Tunnel: A weathered Mabel doll sat at the entrance under a soft, inviting glow—yet it felt like a predator's trap.
0. The Third Tunnel: Simple and unadorned, with a single beam of steady, natural light shining from the far end.
]
|choices)[
(if: $sanity >= 60)[(button:)[[Ending 1]]]
(else:)[(button:)[[Ending 2]]]
]
}


:: StoryScript [script]
window.updateSanityBar = function(value) {
  var numericValue = parseInt(String(value).replace(/[^0-9]/g, '')) || 0;
  var bar = document.getElementById('sanity-fill');
  var container = document.getElementById('sanity-container'); // Get container
  
  if (bar) {
    bar.style.width = numericValue + '%';
    
    if (numericValue <= 30) {
      bar.style.backgroundColor = '#d4183d';
      if (container) container.classList.add('is-danger');
    } else {
      bar.style.backgroundColor = '#ffffff';
      if (container) container.classList.remove('is-danger');
    }
  }
};

var audio = document.createElement('audio');
audio.volume = 0.1;
audio.src = 'https://cdn.freesound.org/previews/511/511496_9405724-lq.mp3';
audio.play();
audio.loop = true;

:: StoryStylesheet [stylesheet]
/* ===========================
   FONT IMPORTS
   =========================== */
@import url('https://fonts.googleapis.com/css2?family=Alike+Angular&family=Bebas+Neue&family=Work+Sans:ital,wght@0,100..900;1,100..900&display=swap');
@import url('https://fonts.cdnfonts.com/css/walktrought');

/* ===========================
   GLOBAL STYLING
   =========================== */
body, tw-story {
  font-family: "Alike Angular", serif;
  font-weight: 400;
  cursor: default;
  user-select: none;
}

/* Hide Twine icons and startup includes */
tw-icon, tw-include[type="startup"] {
  display: none;
}

/* Remove accessibility outline */
.enchantment-clickblock > :not(tw-enchantment)::after {
  box-shadow: none;
}

/* Main story content padding */
tw-story {
  padding-left: 37%;
}

/* ===========================
   SIDEBAR
   =========================== */
tw-sidebar {
  position: fixed;
  top: 0;
  left: 0;
  width: 20%;
  height: 100vh;
  padding: 2em;
  font-family: "Work Sans", sans-serif;
  font-size: 0.7em;
  color: #888;
  text-align: left;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: #000;
}

/* Status text */
span.healthy {
  color: #fff;
  font-family: "Bebas Neue", sans-serif;
}

span.danger {
  color: #d4183d;
  font-family: "Walktrought", serif;
}

/* Sanity meter */
.sanity-bar-bg {
  width: 100%;
  height: 3px;
  background: #333;
  border-radius: 2px;
  margin: 0 0 1em 0;
}

.sanity-bar-fill {
  height: 100%;
  width: 100%;
  background: #fff;
  transition: width 0.4s ease;
}

/* Sidebar divider */
tw-sidebar hr {
  display: block;
  width: 100%;
  height: 1px;
  border: none;
  background-color: #444;
  margin: 0.8em 0;
  opacity: 0.5;
}

/* Push last child to bottom */
tw-sidebar > :last-child {
  margin-top: auto;
  padding-top: 2em;
}

/* ===========================
   BACKGROUND IMAGES
   =========================== */
tw-story[tags~="Scene1"]   { background-image: url("https://i.imgur.com/B5LeAg1.png"); }
tw-story[tags~="Scene1.2"] { background-image: url("https://i.imgur.com/z8ugpSu.png"); }
tw-story[tags~="Scene1.3"] { background-image: url("https://i.imgur.com/8LGJxNw.png"); }
tw-story[tags~="Scene1.4"] { background-image: url("https://i.imgur.com/SAnw4OA.png"); }
tw-story[tags~="Scene1.5"] { background-image: url("https://i.imgur.com/6ZyFNwf.png"); }
tw-story[tags~="Scene1.6"] { background-image: url("https://i.imgur.com/Rkm7CuM.png"); }
tw-story[tags~="Scene1.7"] { background-image: url("https://i.imgur.com/YaiLNGb.png"); }
tw-story[tags~="Scene2"]   { background-image: url("https://i.imgur.com/rfn6rnr.png"); }
tw-story[tags~="Scene2.1"] { background-image: url("https://i.imgur.com/vuv3nqm.png"); }
tw-story[tags~="Scene2.2"] { background-image: url("https://i.imgur.com/hank6Lw.png"); }
tw-story[tags~="Scene2.3"] { background-image: url("https://i.imgur.com/2bGNZnF.png"); }

tw-story[tags~="Scene1"],
tw-story[tags~="Scene1.2"],
tw-story[tags~="Scene1.3"],
tw-story[tags~="Scene1.4"],
tw-story[tags~="Scene1.5"],
tw-story[tags~="Scene1.6"],
tw-story[tags~="Scene1.7"],
tw-story[tags~="Scene2"],
tw-story[tags~="Scene2.1"],
tw-story[tags~="Scene2.2"],
tw-story[tags~="Scene2.3"] {
  background-repeat: no-repeat;
  background-position: right center;
}

/* ===========================
   LETTER
   =========================== */
.letter {
  display: block;
  margin: 20px 0;
  padding: 0 2em;
  max-width: 90%;
  max-height: 40vh;
  height: auto;
  overflow-y: auto;
  overflow-x: hidden;
  background: rgba(0, 0, 0, 0.7); 
  border-left: 4px solid #8B0000; 
  font-style: italic;
  line-height: 1.8;
  font-size: 0.7em;
  text-shadow: 2px 2px 4px rgba(0, 0, 0, 1);
}

/* ===========================
   DIALOG BOX
   =========================== */
.msg-box {
  position: fixed;
  bottom: 0;
  right: 0;
  width: 80%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.msg-name {
  color: #fff;
  text-shadow: black 1px 0 5px;
  font-weight: bold;
  font-size: 1em;
  text-transform: uppercase;
  padding: 10px 1.5em;
}

.msg-content {
  width: 100%;
  min-height: 25vh;
  background: linear-gradient(to top,
    rgba(0, 0, 0, 1) 0%,
    rgba(0, 0, 0, 0.3) 90%,
    rgba(0, 0, 0, 0) 100%
  );
  padding: 0.5em 1.5em;
  line-height: 1.5;
  margin: 0;
  font-size: 1em;
  white-space: normal;
  word-wrap: break-word;
}

/* Next character blinking cursor */
.next-char {
  display: inline-block !important;
  color: red !important;
  font-size: 1em !important;
  font-family: "Alike Angular", serif !important;
  font-weight: bold !important;
  line-height: 1 !important;
  margin-left: 0.5em;
  vertical-align: baseline;
  text-shadow: 0 0 5px black;
  animation: blink 1.5s infinite alternate;
}

@keyframes blink {
  0%, 100% { opacity: 0; }
  50% { opacity: 1; }
}

/* ===========================
   BUTTONS
   =========================== */
.enchantment-button {
  background: rgba(0, 0, 0, 0.85) !important;
  display: flex !important;
  width: 30vw !important;
  min-height: 6vh;
  margin: 10px auto;
  justify-content: center;
  align-items: center;
  outline: 2px solid red;
  box-shadow: 10px 10px 10px black;
}

.enchantment-button:not(.link) tw-link {
  border: none;
}

.enchantment-button:hover {
  background: rgba(0, 0, 0, 0.9) !important;
}

/* ===========================
   POPUP OVERLAY
   =========================== */
.popup-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(0, 0, 0, 0.85);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 9999;
}

.popup-content {
  position: relative;
  display: inline-block;
}

.popup-content img {
  display: block;
  width: auto;
  height: 60vh;
  max-width: 90vw;
  box-shadow: 0 0 30px rgba(0, 0, 0, 0.8);
  border: 1px solid rgba(255, 255, 255, 0.2);
}

/* Close button */
.close-btn {
  position: absolute;
  bottom: -60px;
  left: 50%;
  transform: translateX(-50%);
  cursor: pointer;
  width: 50px;
  height: 50px;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  background: #000;
  border: 1px solid red;
  font-family: Arial, sans-serif;
  font-weight: bold;
  font-size: 20px;
  padding: 0;
  white-space: nowrap;
}
