:: DialogBox {"position":"250,175","size":"100,100"}
{
<!-- ============================================
     CORE UI COMPONENT - DIALOGUE BOX
     Displays character dialogue with typewriter animation
     Handles progression through dialogue steps
     Key Variables Used:
     - $dialogs: Array of dialogue lines
     - $step: Current dialogue index
     - $msgName: Current speaker name
     - $canNext: Can player advance to next line
     - $isTyping: Currently animating text
     ============================================ -->
<!-- 1. DIALOG BOX STRUCTURE -->
<div class="msg-box">
  |nameWrapper>[(if: $msgName is not "")[<div class="msg-name">|nameContainer>[$msgName]</div>]]
  
  <div class="msg-content">
    |box>[
      |typed>[(print: $dialogs's ($step))]
      (change: ?typed's chars, via (t8n-delay: pos * 30) + (t8n: "instant"))
      <span class="next-char">|hintNode>[]</span>
    ]
  </div>
</div>

<!-- 2. INITIALIZE CURRENT SENTENCE STATE -->
(set: $canNext to false)
(set: $isTyping to true)
(set: $clickLock to false)
(set: $currentText to $dialogs's ($step))

<!-- 3. SAFE TIMER LOGIC -->
|timer>[
  (live: ($currentText's length * 30ms + 500ms))[
    (if: $isTyping)[
      (replace: ?hintNode)[ > ]
      (set: $canNext to true)
      (set: $isTyping to false)
    ]
    (replace: ?timer)[] <!-- Stop timer completely by replacing itself -->
    (stop:)
  ]
]
|clickUnlock>[]

<!-- 4. GLOBAL CLICK MONITORING -->
(click-rerun: ?page)[
  (if: $clickLock)[
    (stop:)
  ]
  (else-if: $isTyping)[
    <!-- FIRST CLICK: Show full text -->
    (set: $clickLock to true)
    (set: $isTyping to false)
    (set: $canNext to true)
    (replace: ?box)[
      |typed>[(print: $dialogs's ($step))]
      <span class="next-char">|hintNode>[ > ]</span>
    ]
    (replace: ?timer)[]
    (replace: ?clickUnlock)[
      (live: 60ms)[
        (set: $clickLock to false)
        (replace: ?clickUnlock)[]
        (stop:)
      ]
    ]
  ]
  (else-if: $canNext and not $clickLock)[
    <!-- SECOND CLICK: Advance to next sentence -->
    (set: $clickLock to true)
    (set: $canNext to false)
    (set: $step to it + 1)

    (if: $textTriggerStep > 0 and $step is $textTriggerStep)[
          (show: ?tunnelInfo)
          (set: $textTriggerStep to 0)
      ]
      
    (if: $letterTriggerStep > 0 and $step is $letterTriggerStep)[
      (show: ?revealLink)
      (set: $letterTriggerStep to 0) 
    ]
      
    (if: $audioTriggerStep > 0 and $step is $audioTriggerStep)[
      <!-- Use (print:) to dynamically generate audio effect tags -->
      (print: "<audio src='" + $audioUrl + "' autoplay style='display:none;'></audio>")
      (set: $audioTriggerStep to 0)
    ]

    (if: $popupTriggerStep > 0)[
        (if: $step is $popupTriggerStep)[
          (show: ?PopupWindow)
          (set: $popupTriggerStep to 0) 
        ]
      ]
    
    (if: $step <= $dialogs's length)[
      (set: $msgName to $names's ($step))
      (if: $msgName is not "")[
        (replace: ?nameWrapper)[<div class="msg-name">|nameContainer>[$msgName]</div>]
      ](else:)[
        (replace: ?nameWrapper)[]
      ]
      
      (replace: ?hintNode)[]
      (replace: ?box)[
        |typed>[(print: $dialogs's ($step))]
        (change: ?typed's chars, via (t8n-delay: pos * 30) + (t8n: "instant"))
        <span class="next-char">|hintNode>[]</span>
      ]
      
      <!-- RESTART TIMER LOGIC (remaining code unchanged) -->
      (set: $isTyping to true)
      (set: $clickLock to false)
      (set: $currentText to $dialogs's ($step))
      (replace: ?timer)[
        (live: ($currentText's length * 30ms + 500ms))[
          (if: $isTyping)[
            (replace: ?hintNode)[ > ]
            (set: $canNext to true)
            (set: $isTyping to false)
          ]
          (replace: ?timer)[]
          (stop:)
        ]
      ]
    ]
    (else:)[
      <!-- ALL DIALOGUE END LOGIC -->
      (if: $nextPassage is not "none")[
        (goto: $nextPassage)
      ]
      (else:)[
        (replace: ?hintNode)[]
        (set: $canNext to false)
        (set: $isTyping to false)
        (set: $clickLock to false)
        (replace: ?timer)[]
        (show: ?choices)
      ]
    ]
  ]
]
}


:: Do not look back, run for your life immediately [en] {"position":"2650,450","size":"100,100"}
{
<!-- SURVIVAL OUTCOME: Obey Rule 4
     Player follows the rule and survives the monster encounter
     Meets Astor and Clara who rescue them
     Sanity increased (positive outcome for following rules) -->(set: $sanity to it + 5)
(set: $dialogs to (a: 
  "I lunged into the staff passage, my lungs screaming for air. Just as Mabel's mechanical thuds were right behind me, a door cracked open and I was yanked into a dim room.",
  "Are you okay?",
  "A girl asked, her voice hushed." ,
  "I'm Astor.",
  "the boy next to her said.",
  "And I'm Clara.",
  "I struggled to catch my breath.",
  "I'm... thank you. Thank you for saving me.",
  "Samuel, collapsed in the corner, was trembling violently.",
  "Was that... was that Mabel?",
  "She’s... she’s horrible... I’ve lost my friends. We got separated in the chaos... I don't know where they are...",
  "I'm so sorry.",
  "Clara whispered, placing a hand on his shoulder.",
  "It’s okay",
  "Though my eyes remained fixed on the door.",
  "But do you have any idea what’s happening? Why are we even here? This whole thing... it’s driving me crazy!",
  "The weight of losing everyone was finally breaking Samuel.",
  "Astor looked at us with a grim expression.",
  "We don't know why we were pulled into this world either,",
  "he said, reaching into his bag.",
  "But... we just discovered this."
))

(set: $names to (a: "", "???", "", "Astor", "", "Clara", "", "Me", "", "Samuel", "Samuel", "Clara", "", "Me", "", "Me", "", "", "Astor", "", "Astor"))
(set: $step to 1)
(set: $msgName to $names's ($step))
(set: $nextPassage to "Astor’s Revelation")

(display: "DialogBox")
(display: "Styles")
}


