]


:: Bad Ending 5 [en end Scene4.3] {"position":"2775,1025","size":"100,100"}
{
(set: $sanity to $sanity - 10)

(set: $dialogs to (a: 
  "I tried unlocking the door one last time, betting everything on this final attempt. The lock didn’t even click. Another wrong answer.",
  "Then— it laughed.",
  "Not the soft, hesitant voice from before. This was the child’s laugh twisted into something higher, sharper— like glass being crushed slowly in someone’s fist.",
  "We covered our ears as the fog at our feet began to rise, thickening, tightening around our lungs.",
  "The maze swallowed us whole.",
  "In the end, we suffocated in the spreading mist, trapped forever in this world of stories and rules we never chose.",
  "Death Message: Your answer came from others. Your “self” came from others. In the end, you became just another note someone else wrote."
))

(set: $names to (a: "", "", "", "", "", "", "THE END"))

(set: $step to 1)
(set: $msgName to $names's ($step))
(set: $nextPassage to "none")

(display: "DialogBox")
(display: "Styles")
}

