]


:: Immediately scramble back a few steps [en Scene3] {"position":"1725,600","size":"100,100"}
{
(set: $dialogs to (a: 
  'What are you doing? We have to go!',
  'Samuel barked, lunging forward to grab my arm. He pulled me into a dead sprint toward the exit. Behind us, the staff members stopped their pursuit, watching us with those twisted, frozen expressions.',
  'I tripped and hit the ground hard near the gate.',
  'Holy sh*t, you scared the crap out of me!',
  'Samuel gasped, breathless.',
  'What the hell is going on?',
  "Are you okay? You’ve been acting strange since we got here.",
  "(I didn't answer. My eyes were fixed on the brochure I’d dropped. The ink had changed. The once-boring safety tips were gone, replaced by words written in a violent, bleeding crimson.)",
  'More rules...',
  'I muttered. (I knew this place was off, but I never expected a massacre.)',
  'Samuel looked over my shoulder, his face turning pale.',
  "What kind of sick joke is this? 'Worst possible treatment'?",
  '(I scanned our surroundings. In the distance, a group of those red-uniformed silhouettes was drifting toward us. I checked the map in the brochure.)',
  "We aren't safe here. We need to move, now!",
))
(set: $step to 1)
(set: $names to (a: "Samuel", "", "", "Samuel", "", "Samuel", "Samuel", "", "Me", "", "", "Samuel", "", "Me"))
(set: $msgName to $names's ($step))
(set: $popupImg to "https://i.imgur.com/EmxxNKx.png")
(set: $popupTarget to "") 
(set: $popupTriggerStep to 9)
(set: $nextPassage to "none")

(display: "DialogBox")
(display: "Styles")

<audio src="https://cdn.freesound.org/previews/166/166125_2104797-lq.mp3
" autoplay>
}

