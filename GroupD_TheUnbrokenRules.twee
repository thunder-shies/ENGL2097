:: page23.B.1 [en Scene4.2] {"position":"2775,525","size":"100,100"}
{
(set: $dialogs to (a: 
  "Astor handed us the numbers he had extracted.",
  "Look—4381, 2004, 1111, 0000, 5555. These are all common combinations. But the kid in the recording said, ‘Why listen to them?’ So the code isn’t any of these?",
  "Samuel crossed his arms.",
  "Maybe he’s the type of kid who loves doing the opposite of what he’s told. Always rebellious.",
  "Then maybe the real code is a rearrangement of these numbers— a new sequence formed by flipping their order?"
))

(set: $names to (a: "", "Astor", "", "Samuel", "Me"))

(set: $step to 1)
(set: $msgName to $names's ($step))
(set: $nextPassage to "none")

