(button:)[[Don't Read->page17.B]]
]


:: page17.A [variable en Scene3.4] {"position":"2100,775","size":"100,100"}
{
(set: $letter to true)
(set: $sanity to $sanity + 10)

(set: $dialogs to (a: 
  "We unfolded the note. The handwriting was rushed, almost shaking.",
  "//I’ve never seen monsters this strong—especially the “Hallucinations.” They’re obsessed with the rules. Anyone who breaks one is killed. I don’t know their motive, but they’ve realized my presence threatens their plan. We tourists are trapped in this rule‑bound world. These creatures are beyond anything our organization can handle. I need to gather intel and send it out before more people die. First, I have to survive. This maze belongs to the Hallucinations—one wrong choice and you die lost and confused. I’ve marked the paths I took. If anyone finds this, follow the signs. Stay alive. — Former SCP Field Agent, Mark Davis//",
  "I felt a chill crawl up my spine.",
))

(set: $names to (a: "", "", "",))

(set: $step to 1)
(set: $msgName to $names's ($step))
(set: $nextPassage to "page18.B.1")

(display: "DialogBox")
(display: "Styles")
}


:: page17.B [variable Scene3.6] {"position":"2350,975","size":"100,100"}
{
(set: $letter to false)
(set: $dialogs to (a: 
  "Hey, look! What’s that red arrow?",
  "A faint red arrow was painted on the wall, pointing out of the room.",
  "Strange… it wasn’t here when we came two days ago.",
  "Should we follow it?",
  "If this path leads to the exit, it’s safer than running into the monsters outside. And this route... it connects straight to the park’s main gate. We might actually escape."
))

(set: $names to (a: "Samuel", "", "Astor", "Samuel", "Clara"))

(set: $step to 1)
(set: $msgName to $names's ($step))
(set: $nextPassage to "page20.B")

(display: "DialogBox")
(display: "Styles")
}


:: page18.B.1 [variable en Scene3.6] {"position":"2225,775","size":"100,100"}
{
(set: $dialogs to (a: 
  "SCP… former field agent? What kind of organization is that? Sounds like some secret task force.",
  "I didn’t answer right away. As a content creator, I had heard the name—stories online about the SCP Foundation, a secret group that contained anomalies. Most people treated it as fiction, internet lore. But standing in this maze, holding a note written with shaking urgency…",
  "I’ve heard of it, My friend—the VIP member—mentioned it once. He said there are things in this world we’re not supposed to know. And SCP handles those things.",
  "|shake>[Those things… you mean the monsters here?]",
  "Silence settled over us."
))

(set: $names to (a: "Samuel", "", "Astor", "Samuel", ""))

(set: $step to 1)
(set: $msgName to $names's ($step))

(if: $letter is false)[(set: $nextPassage to "page 25.B")]
(else:)[(set: $nextPassage to "page 19.B")]

(display: "DialogBox")
(display: "Styles")

<audio src="https://cdn.pixabay.com/audio/2025/06/13/audio_e89334f3a8.mp3
" autoplay>
}


:: page20.B [en Scene4] {"position":"2475,875","size":"100,100"}
{
(set: $dialogs to (a: 
  "We followed the others, still unsure, and stepped back into the maze. Endless corridors stretched in every direction.",
  "Along the way, we saw more markings—likely the ones Mark had left behind. We followed them, and soon reached the next room.",
  "It was small. Every wall, from floor to ceiling, was covered in sticky notes and scraps of paper. Layers upon layers—some yellowed and curling, some torn at the edges. Each note had a four‑digit number written on it, all in different handwriting: neat print, messy childlike scrawls, shaky elderly strokes. Red pen, pencil, marker—everything.",
  "Samuel walked straight to the exit door and pushed. It didn’t budge.",
  "Needs a code",
  "I picked up a few notes at random. “1234.” “9999.” “2468.” “1357.” Each corner marked differently—smiley faces, crosses, check marks. Clearly written by different people."
))

(set: $names to (a: "", "", "", "", "Clara", ""))

(set: $step to 1)
(set: $msgName to $names's ($step))
(set: $nextPassage to "page21.B")

(display: "DialogBox")
(display: "Styles")

(set: $Letter to false)
<audio src="https://cdn.freesound.org/previews/393/393824_1931580-lq.mp3
" autoplay>
}


:: page21.B [en Scene4.1] {"position":"2950,1275","size":"100,100"}
{
(set: $dialogs to (a: 
  "There’s a tape recorder here.",
  "An old cassette player sat on the floor, coated in dust, but its red indicator light was still glowing.",
  "I pressed Play.",
  "After a burst of static, a child’s voice drifted out—soft, thin, like he was talking to himself.",
  "“They said… the answer is 4381. Because that’s Dad’s license plate.”",
  "“They said… the answer is 2004. Because that’s the year my sister won her first award.”",
  "“They said… the answer is 1111. Because ‘everyone uses that.’”",
  "“They said… the answer is 0000. Because ‘blank is safest.’”",
  "“They said… the answer is 5555. Because ‘five and five make ten, perfect ten.’”",
  "A pause.",
  "The static grew louder, like a radio tuned to nowhere. When the child spoke again, his voice was barely a whisper—fragile, almost afraid of the question itself.",
  "“But… why do I have to listen to them?”",
  "A long hiss of white noise.",
  "The recording ended.",
  "Silence swallowed the room."
))

(set: $names to (a: "Clara", "", "", "", "", "", "", "", "", "", "", "", "", "", ""))

(set: $step to 1)
(set: $msgName to $names's ($step))
(set: $nextPassage to "page22.B")

(display: "DialogBox")
(display: "Styles")
<audio src="https://cdn.freesound.org/previews/269/269703_2843367-lq.mp3
" autoplay>
}


