{
  background-repeat: no-repeat;
  background-position: right center;
  background-size: cover;
  background-size: 80% 100%;
}

/* ===========================
   LETTER
   =========================== */
.letter {
  display: block;
  margin: 20px 0;
  padding: 0 2em;
  max-width: 90%;
  max-height: 40vh;
  height: auto;
  overflow-y: auto;
  overflow-x: hidden;
  background: rgba(0, 0, 0, 0.7); 
  border-left: 4px solid #8B0000; 
  font-style: italic;
  line-height: 1.8;
  font-size: 0.7em;
  text-shadow: 2px 2px 4px rgba(0, 0, 0, 1);
}

/* ===========================
   DIALOG BOX
   =========================== */
.msg-box {
  position: fixed;
  bottom: 0;
  right: 0;
  width: 80%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  pointer-events: none;
}

.msg-name {
  color: #fff;
  text-shadow: black 1px 0 5px;
  font-weight: bold;
  font-size: 1em;
  text-transform: uppercase;
  padding: 10px 1.5em;
}

.msg-content {
  width: 100%;
  min-height: 25vh;
  background: linear-gradient(to top,
    rgba(0, 0, 0, 1) 0%,
    rgba(0, 0, 0, 0.3) 90%,
    rgba(0, 0, 0, 0) 100%
  );
  padding: 0.5em 1.5em;
  line-height: 1.5;
  margin: 0;
  font-size: 1em;
  white-space: normal;
  word-wrap: break-word;
  pointer-events: auto;
}

/* Next character blinking cursor */
.next-char {
  display: inline-block !important;
  color: red !important;
  font-size: 1em !important;
  font-family: "Alike Angular", serif !important;
  font-weight: bold !important;
  line-height: 1 !important;
  margin-left: 0.5em;
  vertical-align: baseline;
  text-shadow: 0 0 5px black;
  animation: blink 1.5s infinite alternate;
}

@keyframes blink {
  0%, 100% { opacity: 0; }
  50% { opacity: 1; }
}

/* ===========================
   FIX: REMOVE ENCHANT VISUALS
   =========================== */

/* 1. 移除點擊區域的藍色外框與陰影 */
.enchantment-clickblock, 
tw-enchantment,
tw-hook[name="dialoguearea"] {
  outline: none !important;
  box-shadow: none !important;
  border: none !important;
}

/* 2. 確保滑鼠指針在對話框上維持預設（除非你想讓它變手型） */
tw-hook[name="dialoguearea"] {
  cursor: default !important;
  /* 防止 Harlowe 改變其佈局屬性 */
  display: block !important; 
}

/* 3. 如果你的文字出現了底線或變色，強制重置 */
tw-hook[name="dialoguearea"] :not(a) {
  text-decoration: none !important;
}

/* ===========================
   BUTTONS
   =========================== */
.enchantment-button {
  background: rgba(0, 0, 0, 0.85) !important;
  display: flex !important;
  width: 30vw !important;
  min-height: 6vh;
  margin: 10px auto;
  justify-content: center;
  align-items: center;
  outline: 2px solid red;
  box-shadow: 10px 10px 10px black;
}

.enchantment-button:not(.link) tw-link {
  border: none;
}

.enchantment-button:hover {
  background: rgba(0, 0, 0, 0.9) !important;
}

/* ===========================
   FORM CONTROLS
   =========================== */
tw-story input[type=text] {
  padding: 10px 5px;
  border-radius: 5px;
  background: rgba(0, 0, 0, 0.85);
  color: #fff;
  font-family: "Work Sans", sans-serif;
  text-align: center;
  letter-spacing: 0.1em;
  caret-color: #d4183d;
}

body > tw-enchantment > tw-story > tw-passage > tw-collapsed > tw-hook > tw-expression:nth-child(3) {
  border: 0px;
}

input[type="text"]::selection,
input[type="password"]::selection,
textarea::selection {
  background: #d4183d;
  color: #fff;
}

/* ===========================
   POPUP OVERLAY
   =========================== */
.popup-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(0, 0, 0, 0.85);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 9999;
}

.popup-content {
  position: relative;
  display: inline-block;
}

.popup-content img {
  display: block;
  width: auto;
  height: 60vh;
  max-width: 90vw;
  box-shadow: 0 0 30px rgba(0, 0, 0, 0.8);
  border: 1px solid rgba(255, 255, 255, 0.2);
}

/* Close button */
.close-btn {
  position: absolute;
  bottom: -60px;
  left: 50%;
  transform: translateX(-50%);
  cursor: pointer;
  width: 50px;
  height: 50px;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  background: #000;
  border: 1px solid red;
  font-family: Arial, sans-serif;
  font-weight: bold;
  font-size: 20px;
  padding: 0;
  white-space: nowrap;
}