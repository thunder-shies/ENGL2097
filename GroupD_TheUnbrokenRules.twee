:: page.30.A.1 [en Scene7] {"position":"4150,700","size":"100,100"}
{
(set: $dialogs to (a: 
  "No! We were just trying to get out of the park!",
  "Mabel stopped—then burst into shrill, mocking laughter.",
  "Foolish humans… hahaha! Did you really think you could escape?",
  "With that, she turned away and slowly walked off, her footsteps scraping against the ground.",
  "The moment her figure disappeared into the shadows, we sprinted toward the staff's office, desperate for any place to hide.",
  "Samuel let out a shaky breath, his voice barely holding together.",
  "Thank god… we’re alive", 
  "He murmured, and for a moment, we all felt the same fragile relief."
))

(set: $names to (a: "Me", "", "Mabel", "", "", "","Samuel", ""))

(set: $step to 1)
