:: Bad Ending 11 [en end] {"position":"6700,1100","size":"100,100"}
{(set: $sanity to 0)
(set: $dialogs to (a: 
  "The moment we stepped toward the exit, a sharp, tearing pain ripped through our bodies.",
  "Our vision blurred.",
  "Our thoughts dissolved.",
  "Piece by piece, our minds slipped away, swallowed by the illusion.",
  "In the end, we dissolved, endlessly, into the park’s unending dreamscape...",
  "|shake>[Cause of death: Illusion consumed us.]"
))

(set: $names to (a: "", "", "", "", "", "THE END"))
