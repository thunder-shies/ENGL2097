:: Sidebar [sidebar] {"position":"400,50","size":"100,100"}
{
<!-- PERSISTENT SIDEBAR - Always visible on right side
     Displays: Player status, sanity meter, inventory
     Sanity changes color based on danger level
     Updates in real-time as story progresses -->(append: ?Sidebar)[
$statusText[STATUS]
<br>
$sanityText[SANITY]
(if: $sanity <= 30)[<script>$('span').addClass('danger');</script>]\
(else:)[<script>$('span').addClass('healthy');</script>]
<span id="sanity-val">$sanityNumText[$sanity%]</span>

<div class="sanity-bar-bg">
  <div class="sanity-bar-fill" id="sanity-fill"></div>
</div>
<script>
  setTimeout(function() {
    var textEl = document.getElementById('sanity-val');
    if (textEl) {
      var val = parseInt(textEl.innerText);
      window.updateSanityBar(val);
    }
  }, 100);
</script>

<hr>
$invText[INVENTORY]
(if: $hasRulesBrochure or $hasUpdatedRules or $hasDrifterWarning)[
  (if: $hasRulesBrochure)[
    (link: "Rules Brochure")[
      (set: $popupImg to "https://i.imgur.com/xjMiha8.png")
      (show: ?PopupWindow)
    ]
    <br>
  ]
  (if: $hasUpdatedRules)[
    (link: "Updated Rules")[
      (set: $popupImg to "https://i.imgur.com/EmxxNKx.png")
      (show: ?PopupWindow)
    ]
    <br>
  ]
  (if: $hasDrifterWarning)[
    (link: "Drifter's Warning")[
      (set: $popupImg to "https://i.imgur.com/evSo7Sf.png")
      (show: ?PopupWindow)
    ]
  ]
]
(else:)[
  $itemText[Empty]
]
<br>
$footerText[Maintain your composure.]
]
}


:: Stand your ground, too terrified to move [en end Scene2.4] {"position":"1725,325","size":"100,100"}
{(set: $sanity to it -8)
(set: $dialogs to (a: 
  "I stood rooted to the spot, not daring to flinch. The rule was clear: |imp>[Do not leave without instruction.] (I clung to that sentence like a lifeline, quickly shoving my phone into my pocket. My entire body shook as I stared into the contorted, hideous face of the creature before me.)",
  "The staff member tilted its head, its voice a sickening, dry rasp.",
  "|imp>[So obedient,]",
  "it hissed. ",
  "|imp>[And yet... you are still too late.]",
  "(Before I could even gasp, its jagged, inhuman claw lunged forward. It didn't just stab me; it skewered my chest. A dull, cold shock radiated from the wound, followed by a searing heat that consumed my lungs.)",
  "I looked down, watching my own blood drench the very rules I had tried so hard to follow. (Darkness began to cloud my vision, and as my heart gave its final, frantic thud, I realized the cruelest truth of this park:)",
  "(text-style:'shudder')|imp>[In here, the rules weren't meant to save you. They were only meant to keep you still long enough for the slaughter.]",
  "|shake>[Cause of death: Obedience exploited — slaughter by staff.]",
))
(set: $names to (a: "", "", "Staff", "", "Staff", "", "", "", "THE END"))
(set: $step to 1)
(set: $msgName to $names's 1)
(set: $nextPassage to "none")
(set: $audioTriggerStep to 8)
(set: $audioUrl to "https://cdn.freesound.org/previews/584/584318_12865053-lq.mp3")

(display: "DialogBox")
(display: "Styles")

<audio src="https://cdn.freesound.org/previews/713/713696_10403690-lq.mp3
" autoplay>
}

|choices)[
(button:)[[Go back->Enforcement by Blood]]
]


:: Start [en] {"position":"100,500","size":"100,100"}
{
<!-- ============================================
     OPENING PASSAGE - GAME START
     Introduces the protagonist's journey to the
     mysterious amusement park
     ============================================ -->
(set: $dialogs to (a: 
  'Recently, a newly opened theme park has seen an astonishing influx of visitors, as if everyone were irresistibly drawn to it.',
  'Particularly captivating is the |highlight>[circus performance] at the |imp>["Dreamland Circus,"] which has just recently opened.',
  'Word has it that some guests visit three to four times a week, which seems quite exaggerated.',
  'As a content creator, I booked tickets to the circus. Due to the crowd, the only remaining options were at night.'
))
(set: $names to (a: "", "", "", ""))
(set: $step to 1)
(set: $msgName to $names's 1)
(set: $nextPassage to "Dusk at the Gates")

(display: "DialogBox")
(display: "Styles")
}


:: Startup [startup] {"position":"100,50","size":"100,100"}
{
<!-- ============================================
     INITIALIZATION PASSAGE
     Sets up all game variables, tracking flags,
     and styling that persist throughout gameplay
     ============================================ -->

<!-- PLAYER STATUS & STATS -->
(set: $sanity to 100)
(set: $currentStatus to "Calm")
(set: $inventory to (a:))
(set: $hasRulesBrochure to false)
(set: $hasUpdatedRules to false)
(set: $hasDrifterWarning to false)

<!-- STORY BRANCH FLAGS - Track major decisions that affect gameplay outcomes -->
(set: $drifterHint to false)              <!-- Did player listen to the drifter? -->
(set: $friendMurder to false)             <!-- Did player push away the drifter? -->
(set: $isAskingAboutFriend to false)      <!-- Did player ask staff about escape? -->
(set: $isHonestAboutDrifter to false)     <!-- Did player tell Samuel the truth about drifter? -->
(set: $isHonestAboutStaff to false)       <!-- Player's trust level with staff -->
(set: $trustsAstor to false)              <!-- Does player trust Astor? -->
(set: $hasSeenColorRule to false)         <!-- Has player discovered the color-based rule system? -->

<!-- UI STYLING - Text color, size, and effects for displaying information -->
(set: $statusText to (text-color:#909090)+(font:"Bebas Neue"))
(set: $sanityText to (text-style:"expand")+(text-style:"subscript"))
(set: $sanityNumText to (text-size:2))
(set: $invText to (text-style:"expand")+(text-style:"subscript"))
(set: $itemText to (text-color:#666))
(set: $footerText to (text-color:#444)+(text-size:0.5))
(set: $type to (char-style: via (t8n-delay: pos * 30) + (t8n: "instant")))
(set: $samStart to '<div class="msg-box"><div class="msg-name">Samuel</div><div class="msg-content">')
(set: $msgEnd to '</div></div>')
(set: $textTriggerStep to 0)
(set: $popupTriggerStep to 0)
(set: $letterTriggerStep to 0)
(set: $audioTriggerStep to 0)
(set: $popupImg to "")
(set: $popupTarget to "")
(set: $letter to true)
}


:: Styles {"position":"100,175","size":"100,100"}
{
<!-- STYLING COMPONENT
     Applies visual effects to tagged text:
     - link: Red color, hover effects
     - highlight: Red emphasized text
     - imp: Important/ominous text (red, blinking, shudder)
     - shake: Red text with rumble effect -->
(enchant: ?link, (text-color:#d4183d)+(hover-style:(text-style:"tall","condense","shudder")))

(enchant:?highlight, (text-color:#d4183d)+(hover-style:(text-color:red)+(text-style:"tall","condense")+(text-size:1.2)))

(enchant:?imp, (text-color:#d4183d)+(text-style:"blurrier","blink")+(hover-style:(text-color:red)+(text-style:"smear","tall","fidget","expand")+(font: "Walktrought")))

(enchant: ?shake, (text-color:red)+(text-style:"bold","rumble"))

(enchant: ?letter, (text-color:red)+(text-style:"bold","rumble")+(font: "Walktrought")+(css: "text-transform: uppercase;"))

}


