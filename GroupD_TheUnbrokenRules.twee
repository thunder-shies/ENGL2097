:: Bad Ending 10 [en end Scene7.1] {"position":"5300,525","size":"100,100"}
{(set: $sanity to 0)
(set: $dialogs to (a: 
  "We vaguely remembered the rule about seeking help from the security guard.",
  "Gathering my courage, I asked, Do you know how to get from here to the parking lot?",
  "The guard tilted his head.",
  "Then he let out a strange, broken laugh.",
  "You really think… you can escape?",
  "Before we could react, he struck.",
  "Pain exploded through us, and our bodies collapsed to the floor.",
  "Our vision dimmed.",
  "The last thing we saw was his twisted smile.",
  "|shake>[Cause of death: Asked the guard for help.]"
))

(set: $names to (a: "", "Me", "", "", "Security", "", "", "", "", "THE END"))
(set: $step to 1)
(set: $msgName to $names's ($step))
(set: $nextPassage to "none")

(display: "DialogBox")
(display: "Styles")

