(set: $dialogs to (a: 
  "We burst out of the passage, running toward the faint light ahead.",
  "Astor—that must be the exit Mark mentioned!",
  "But the moment we reached it, we froze.",
  "On the ground lay an insignia of the SCP Foundation, stained with a long-dried pool of blood.",
  "Mark… he…",
  "None of us finished the sentence.",
  "Ahead of us stood three doors, each dimly lit, each leading somewhere unknown.",
  "First door: A steady red glow leaked from the crack beneath the door. The light didn’t flicker. Behind it, synchronized footsteps marched in perfect rhythm. A dark blue ribbon was tied neatly around the handle.",
  "Second door: A metal gate with bars just wide enough for someone to squeeze through sideways. A rusted padlock hung from it—unlocked, almost inviting.",
  "Third door: A faint white light seeped from the bottom. The door itself was plain, but as we leaned closer… familiar voices whispered from the other side.",
  "This is probably the illusion’s final test…",
  "Behind us, the guard’s growls grew louder.",
  "He was getting closer.",
  "No time to think!",
  "I clenched my teeth and made my choice:"
))

(set: $names to (a: "", "Me", "", "", "Clara", "", "", "", "", "", "Me", "", "", "Clara", ""))
(set: $step to 1)
(set: $msgName to $names's ($step))
(set: $nextPassage to "none")

(display: "DialogBox")
(display: "Styles")

<audio src="https://cdn.freesound.org/previews/731/731716_15403889-lq.mp3
" autoplay>
}

|choices)[
(button:)[[Door 1->Bad Ending 11]]
(button:)[[Door 2->Bad Ending 11]]
(button:)[[Door 3]]
]


:: StoryScript [script]
window.updateSanityBar = function(value) {
  var numericValue = parseInt(String(value).replace(/[^0-9]/g, '')) || 0;
  var bar = document.getElementById('sanity-fill');
  var container = document.getElementById('sanity-container'); // Get container
  
  if (bar) {
    bar.style.width = numericValue + '%';
    
    if (numericValue <= 30) {
      bar.style.backgroundColor = '#d4183d';
      if (container) container.classList.add('is-danger');
    } else {
      bar.style.backgroundColor = '#ffffff';
      if (container) container.classList.remove('is-danger');
    }
  }
};

var audio = document.createElement('audio');
audio.volume = 0.1;
audio.src = 'https://cdn.freesound.org/previews/511/511496_9405724-lq.mp3';
audio.play();
audio.loop = true;

:: StoryStylesheet [stylesheet]
/* ===========================
   FONT IMPORTS
   =========================== */
@import url('https://fonts.googleapis.com/css2?family=Alike+Angular&family=Bebas+Neue&family=Work+Sans:ital,wght@0,100..900;1,100..900&display=swap');
@import url('https://fonts.cdnfonts.com/css/walktrought');

/* ===========================
   GLOBAL STYLING
   =========================== */
body, tw-story {
  font-family: "Alike Angular", serif;
  font-weight: 400;
  cursor: default;
  user-select: none;
}

/* Hide Twine icons and startup includes */
tw-icon, tw-include[type="startup"] {
  display: none;
}

/* Remove accessibility outline */
.enchantment-clickblock > :not(tw-enchantment)::after {
  box-shadow: none;
}

/* Main story content padding */
tw-story {
  padding-left: 37%;
}

/* ===========================
   SIDEBAR
   =========================== */
tw-sidebar {
  position: fixed;
  top: 0;
  left: 0;
  width: 20%;
  height: 100vh;
  padding: 2em;
  font-family: "Work Sans", sans-serif;
  font-size: 0.7em;
  color: #888;
  text-align: left;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: #000;
}

/* Status text */
span.healthy {
  color: #fff;
  font-family: "Bebas Neue", sans-serif;
}

span.danger {
  color: #d4183d;
  font-family: "Walktrought", serif;
}

/* Sanity meter */
.sanity-bar-bg {
  width: 100%;
  height: 3px;
  background: #333;
  border-radius: 2px;
  margin: 0 0 1em 0;
}

.sanity-bar-fill {
  height: 100%;
  width: 100%;
  background: #fff;
  transition: width 0.4s ease;
}

/* Sidebar divider */
tw-sidebar hr {
  display: block;
  width: 100%;
  height: 1px;
  border: none;
  background-color: #444;
  margin: 0.8em 0;
  opacity: 0.5;
}

/* Push last child to bottom */
tw-sidebar > :last-child {
  margin-top: auto;
  padding-top: 2em;
}

/* ===========================
   BACKGROUND IMAGES
   =========================== */
tw-story[tags~="Scene1"]   { background-image: url("https://i.imgur.com/B5LeAg1.png"); }
