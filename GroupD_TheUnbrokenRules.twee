:: page15.B [en Scene3.3] {"position":"1975,775","size":"100,100"}
{
(set: $dialogs to (a: 
  "//The bloodstains at the doorway brought me an unease I couldn't shake.// I stood behind Samuel as he pushed the door open.",
  "A faint light flickered on at the back of the room, revealing two figures curled in the corner. Both were smeared with dried blood, staring at us in shock.",
  "The door behind us shut on its own, clicking like a trap resetting. No turning back now.",
  "Hi… I’m Clara",
  "I am Astor",
  "Finally, real people.",
  "The moment we stepped inside, (the door shut behind us with a loud bang). It is one of the maze's cruel tricks—once one has chosen his own paths, there will be no turning back for him. |highlight>[Every step is a gamble.]",
  "Do you two know what's happening?",
  "We have no idea.",
  "We ran straight here when we saw those… ''things''. Everything was fine just a few days ago and now there are monsters and crazy shit I never thought that actually exist.",
  "Have you been here before?",
  "My friend—he’s a VIP here—brought us often. He was supposed to meet us, but then he just… vanished.",
  "//My mind got flooded with so many questions—so many question marks in my mind that I barely knew where to start. Before I could keep on asking, Samuel cut in.//",
  "Hey, there’s a letter here!",
  "A nearly invisible sheet of paper lay on the desk—easy to miss unless you were looking for it."
))

(set: $names to (a: "", "", "", "Clara", "Astor", "Samuel", "", "Me", "Clara", "Astor", "Me", "Astor", "", "Samuel", ""))

(set: $step to 1)
(set: $msgName to $names's ($step))
(set: $nextPassage to "none")

(display: "DialogBox")
(display: "Styles")
}

