:: page33.C [en Scene7.1] {"position":"4775,675","size":"100,100"}
{
(set: $dialogs to (a: 
  "We’re running out of time. Let’s find the passage first.",
  "We slipped out of the employee office floor, checked that the hallway was clear, and immediately searched the area for the entrance.",
  "We looked everywhere, dodging staff members as we moved, but the passage was nowhere to be found.",
  "Where the hell is it?!",
  "Astor frowned.",
  "A friend of mine said staff often move huge props from the parking lot. Maybe the passage is near wherever they store those props?",
  "Clara nodded.",
  "Mark said the passage is for transporting props… so if that’s true… the circus might be where it is.",
  "We exchanged a quick look—",
  "then sprinted toward the circus."
))

(set: $names to (a: "Me", "", "", "Samuel", "", "Astor", "", "Clara", "", ""))
