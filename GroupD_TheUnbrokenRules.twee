:: page23.B [en Scene4] {"position":"2775,900","size":"100,100"}
{
(set: $sanity to $sanity + 10)

(set: $dialogs to (a: 
  "I tried using the barely noticeable model number on the tape recorder as the code.",
  "The lock clicked open with a sharp \"click\" sound.",
  "Everyone stared at me in disbelief.",
  "How did you know?",
  "It never appeared on any of the notes or recordings.",
  "I swept my eyes across the wall.", 
  "No one wrote 0615. No one suggested 0615. It’s the only number that didn’t come from someone else — it came from the machine itself.",
  "At that moment, a faint voice leaked from the recorder:",
  "I like June fifteenth… No one yelled at me that day.",
  "Maybe… it was the child’s birthday",
  "None of us spoke after that.",
  "We decided to follow the markings and keep moving."
))

(set: $names to (a: "", "", "", "Astor", "Me", "", "Me", "", "Clara", "", "", "", ""))

(set: $step to 1)
