:: page 25.B [en Scene5.1] {"position":"3025,975","size":"100,100"}
{
(set: $dialogs to (a: 
  "Seeing all this, something stirred in my memory— back when I studied media, there had been a similar case in the news. And now, after reading the whole story, I couldn’t shake the heaviness in my chest.",
  "So… what do we do now?",
  "That looks like the exit of the maze. Let’s go check it out.",
  "We returned to the Door of Choice.",
  "Two doors stood before us. From the cracks, faint sounds leaked through:",
  "The left door carried the rhythm of synchronized footsteps, applause, a crowd moving in perfect unison.",
  "The right door whispered with lonely wind, fragmented murmurs, and a quiet that felt almost human.",
  "We would choose:"
))

(set: $names to (a: "", "Astor", "Clara", "", "", "", "", ""))

(set: $step to 1)
(set: $msgName to $names's ($step))
(set: $nextPassage to "none")

(display: "DialogBox")
(display: "Styles")
}

|choices)[
(button:)[[Left Door ->Bad Ending 6.1]]
(button:)[[Right Door ->page26.B]]
]


:: page.28.A [en Scene6.2] {"position":"3650,925","size":"100,100"}
{
(set: $dialogs to (a: 
  "A horrifying amusement‑park mascot stepped into view—its face torn, yet frozen in a stiff, mechanical grin. Samuel and Clara screamed.",
  "The doll tilted her head, voice soft and almost tender.",
  "Are you… afraid of me?",
  "Then came a sound caught between twisted laughter and a breakdown. She reached toward us, fingers curling as if ready to snap our necks.",
  "Astor grabbed my arm.",
  "Run!",
  "We bolted, sprinting back toward the circus path. But the doll chased us without slowing—relentless, echoing footsteps behind us.",
  "When we reached the area beside the circus tent, our hearts dropped. We had run straight into a dead end. Only the towering amusement‑park walls surrounded us."
))

(set: $names to (a: "", "", "Mabel", "", "", "Astor", "", ""))

(set: $step to 1)
(set: $msgName to $names's ($step))
(set: $nextPassage to "page29.A")

